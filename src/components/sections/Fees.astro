---
import { fetchConfig, fetchEventTickets } from '../../lib/supabase';
import { ShieldAlert } from 'lucide-react';

const config = await fetchConfig();
const editionId = config.edition?.id || "";

// Fetch dynamic event tickets
const dbTickets = editionId ? await fetchEventTickets(editionId) : [];

// Benefit mapping by ticket name
function getTicketBenefits(name: string): string[] {
  const norm = name.toUpperCase();
  if (norm.includes('PREGADO') || norm.includes('PREGRADO')) {
    return [
      'Acceso a todas las ponencias y talleres',
      'Materiales impresos y digitales del evento',
      'Certificado de participación digital oficial (24 horas académicas)',
      'Acceso a las grabaciones de las ponencias'
    ];
  }
  if (norm.includes('POSTGRADO')) {
    return [
      'Acceso completo a conferencias y mesas de debate',
      'Prioridad en talleres metodológicos prácticos',
      'Material digital oficial de la Escuela de Postgrado',
      'Certificado oficial digital de aprobación/participación (36 horas académicas)',
      'Publicación de resúmenes aprobados en el libro digital'
    ];
  }
  // Default/Público General
  return [
    'Acceso a ponencias magistrales e investigación libre',
    'Kit completo del participante (mochila, cuaderno, lapicero oficial)',
    'Certificado digital institucional de participación (24 horas académicas)',
    'Materiales y resúmenes compartidos por correo electrónico'
  ];
}

// Format category name for nice display
function formatCategory(name: string): string {
  const norm = name.toUpperCase();
  if (norm === 'PREGADO' || norm === 'PREGRADO') return 'Pregrado';
  if (norm === 'POSTGRADO') return 'Postgrado';
  if (norm === 'PUBLICO GENERAL') return 'Público General';
  return name;
}

const feesToRender = dbTickets.map((ticket: any) => ({
  id: ticket.id,
  category: formatCategory(ticket.name),
  price: Number(ticket.price),
  benefits: getTicketBenefits(ticket.name),
  popular: ticket.name.toUpperCase().includes('POSTGRADO')
}));

// Section settings from database
const sectionSettings = config.event?.settings?.landing_sections?.fees;
const tagline = sectionSettings?.tagline || "Derechos de Certificación";
const title = sectionSettings?.title || "Inversión Académica y Certificación";
const description = sectionSettings?.description || "El ingreso a las ponencias académicas es gratuito. Sin embargo, para obtener la certificación institucional firmada por la Escuela de Postgrado de la UNAP (válida por horas académicas), se aplica la siguiente escala:";
const paymentNote = sectionSettings?.payment_note || "Los depósitos se realizan en la cuenta corriente del Banco de la Nación a nombre de la Universidad Nacional de la Amazonía Peruana. El comprobante deberá ser registrado en la ficha digital de inscripción para validar el trámite de certificación.";
---

{feesToRender.length > 0 && (
  <section id="tarifas" class="relative py-24 bg-dark">
    <!-- Glowing elements -->
    <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container mx-auto px-6 md:px-12 relative z-10">
      
      <!-- Section Header -->
      <div class="text-center mx-auto mb-16 flex flex-col gap-4">
        <span class="text-xs font-bold text-secondary uppercase tracking-widest">
          {tagline}
        </span>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-light">
          {title}
        </h2>
        <p class="text-sm sm:text-base text-light/75 leading-relaxed">
          {description}
        </p>
      </div>

      <!-- Pricing Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch max-w-5xl mx-auto">
        {feesToRender.map((fee) => (
          <div 
            class={`relative glass-card rounded-3xl p-8 border flex flex-col justify-between transition-all duration-300 ${
              fee.popular 
                ? 'border-secondary bg-dark/80 shadow-[0_0_30px_rgba(76,175,80,0.15)] scale-103 md:-translate-y-2 z-10' 
                : 'border-accent/15 hover:border-accent/30'
            }`}
          >
            {/* Popular Tag Badge */}
            {fee.popular && (
              <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-secondary text-dark font-display font-black text-[10px] uppercase tracking-widest px-4 py-1.5 rounded-full shadow-md">
                Recomendado
              </div>
            )}

            <div>
              {/* Header info */}
              <div class="text-center mb-6 border-b border-accent/10 pb-6">
                <span class="text-xs font-bold text-accent uppercase tracking-widest block mb-2">{fee.category}</span>
                <div class="flex items-baseline justify-center gap-1.5 text-light">
                  <span class="text-2xl font-bold">S/.</span>
                  <span class="text-5xl font-display font-black leading-none">{fee.price.toFixed(2)}</span>
                </div>
                <span class="text-[10px] text-light/50 font-medium mt-1.5 block">Pago único por derecho de certificado</span>
              </div>

              {/* Benefits list */}
              <ul class="flex flex-col gap-4 mb-8">
                {fee.benefits.map((benefit) => (
                  <li class="flex gap-3 items-start text-xs sm:text-sm text-light/85 leading-relaxed">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-4 h-4 text-secondary shrink-0 mt-0.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    <span>{benefit}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Action CTA -->
            <div class="mt-auto">
              <a 
                href="/registro" 
                class={`w-full text-center inline-block font-display font-bold text-sm py-3 px-6 rounded-xl transition-all cursor-pointer ${
                  fee.popular 
                    ? 'bg-secondary text-dark hover:bg-accent shadow-md shadow-secondary/10' 
                    : 'bg-primary/10 hover:bg-primary/20 text-light border border-accent/10 hover:border-accent/20'
                }`}
              >
                Pre-inscribirme en esta categoría
              </a>
            </div>

          </div>
        ))}
      </div>

      {/* Information Callout */}
      <div class="max-w-3xl mx-auto mt-12 p-5 bg-primary/5 border border-primary/20 rounded-2xl flex gap-3.5 items-start">
        <ShieldAlert class="w-5 h-5 text-secondary shrink-0 mt-0.5" />
        <p class="text-xs text-accent/80 leading-relaxed">
          <strong>Nota importante:</strong> {paymentNote}
        </p>
      </div>

    </div>
  </section>
)}


