---
import { SCIENTIFIC_AREAS } from '../../constants/eventData';

// Map icon name to customized inline SVG markup
const getIconSvg = (iconName: string) => {
  switch (iconName) {
    case 'HeartPulse':
      return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l1.5-2 2 4 1.5-2h3.78"/></svg>`;
    case 'Leaf':
      return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 3.5 1 9.8a7 7 0 0 1-9 8.2Z"/><path d="M9 22v-4h-2.5A2.5 2.5 0 0 1 4 15.5V14"/></svg>`;
    case 'Cpu':
      return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M9 1v3"/><path d="M15 1v3"/><path d="M9 20v3"/><path d="M15 20v3"/><path d="M20 9h3"/><path d="M20 15h3"/><path d="M1 9h3"/><path d="M1 15h3"/></svg>`;
    case 'Globe2':
      return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>`;
    default:
      return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-7 h-7"><circle cx="12" cy="12" r="10"/></svg>`;
  }
};
---

<section id="areas" class="relative py-24 bg-dark">
  <!-- Visual Amazon rainforest leaves ambient blur background -->
  <div
    class="absolute bottom-1/4 right-0 w-80 h-80 bg-primary/10 rounded-full blur-3xl pointer-events-none"
  >
  </div>

  <div class="container mx-auto px-6 md:px-12 relative z-10">
    <div class="text-center mx-auto mb-16 flex flex-col gap-4">
      <span class="text-xs font-bold text-secondary uppercase tracking-widest">
        Líneas Temáticas
      </span>
      <h2 class="font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-light">
        Áreas Científicas del Encuentro
      </h2>
      <p class="text-sm sm:text-base text-light/75 leading-relaxed">
        El encuentro promueve la discusión crítica y la difusión de resultados en cuatro ejes
        temáticos fundamentales para la conservación y el desarrollo sostenible de la región
        Amazónica.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        SCIENTIFIC_AREAS.map((area, index) => (
          <div class="glass-card rounded-2xl p-6 sm:p-8 border border-accent/10 hover:border-secondary/40 transition-all duration-300 flex flex-col justify-between group hover:scale-[1.02] cursor-pointer hover:shadow-xl hover:shadow-primary/5">
            <div>
              {/* Header Icon container */}
              <div
                class="w-14 h-14 bg-primary/10 border border-primary/20 text-secondary group-hover:bg-primary group-hover:text-dark rounded-2xl flex items-center justify-center mb-6 transition-all duration-300"
                set:html={getIconSvg(area.iconName)}
              />

              <h3 class="font-display font-bold text-lg sm:text-xl text-light group-hover:text-secondary transition-colors mb-3">
                {area.title}
              </h3>

              <p class="text-xs sm:text-sm text-light/75 leading-relaxed">{area.description}</p>
            </div>

            <div class="mt-8 flex items-center gap-2 text-xs font-bold text-accent group-hover:text-secondary transition-colors">
              <span>Explorar ponencias</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2.5"
                stroke="currentColor"
                class="w-4 h-4 group-hover:translate-x-1 transition-transform"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                />
              </svg>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
