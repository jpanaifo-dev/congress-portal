---
import { Gallery } from '../ui/Gallery';
---

<section id="galeria" class="relative py-24 bg-dark/30 overflow-hidden">
  <!-- Glowing element -->
  <div
    class="absolute bottom-10 left-10 w-80 h-80 bg-secondary/5 rounded-full blur-3xl pointer-events-none"
  >
  </div>

  <div class="container mx-auto px-6 md:px-12 relative z-10">
    <!-- Section Header -->
    <div class="text-center mx-auto mb-16 flex flex-col gap-4">
      <span class="text-xs font-bold text-secondary uppercase tracking-widest">
        Registro Fotográfico
      </span>
      <h2 class="font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-white">
        Galería de la Comunidad Científica
      </h2>
      <p class="text-sm sm:text-base text-light/75 leading-relaxed">
        Compartimos momentos clave de nuestras labores de campo, laboratorios de investigación y la
        excelencia académica de nuestros estudiantes y ponentes.
      </p>
    </div>

    {/* Gallery component embed */}
    <Gallery client:visible />
  </div>
</section>
