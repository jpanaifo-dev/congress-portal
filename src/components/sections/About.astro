---
import { HeartPulse, Leaf, Cpu, Scale } from 'lucide-react';
---

<section
  id="sobre-evento"
  class="relative py-24 bg-dark overflow-hidden border-b border-white/[0.05]"
>
  <div class="container mx-auto px-6 md:px-12 relative z-10">
    <div class="mx-auto flex flex-col text-left">
      <!-- Accent Definition Block -->
      <div class="relative border-l-[6px] border-jsyellow pl-8 mb-8">
        <span class="text-[11px] font-mono tracking-widest text-light/40 uppercase block mb-3">
          — Escuela de Postgrado
        </span>
        <h2
          class="font-display font-extrabold text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-light leading-tight"
        >
          Encuentro — <span class="text-light/60"
            >espacio de convergencia para difundir e impulsar la investigación científica en la
            Amazonía.</span
          >
        </h2>
      </div>

      <!-- Description Paragraph -->
      <div class="max-w-3xl mb-16">
        <p class="text-base sm:text-lg text-light/70 leading-relaxed font-sans">
          El III Encuentro Científico es un evento de dos días (<strong
            class="text-light font-semibold">02 y 03 de julio de 2026</strong
          >) que se llevará a cabo de forma presencial y virtual en la <strong
            class="text-light font-semibold">Escuela de Postgrado</strong
          >. Está especialmente dirigido a investigadores, docentes, estudiantes de pregrado y
          postgrado, y profesionales dedicados a la construcción de conocimiento para la región.
        </p>
      </div>

      <!-- Topics / Insights Section -->
      <div class="mb-16">
        <p class="text-sm sm:text-base text-light/80 font-medium mb-10 leading-relaxed">
          Las investigaciones inscritas pueden pertenecer a las siguientes áreas:
        </p>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-y-8 gap-x-4 max-w-3xl">
          {/* Area 1: Ciencias de la Salud */}
          <div class="flex flex-col items-center gap-4 group cursor-default">
            <div
              class="w-16 h-16 bg-light/5 border border-light/10 rounded-2xl flex items-center justify-center text-light/50 group-hover:text-jsyellow group-hover:border-jsyellow/40 transition-all duration-300"
            >
              <HeartPulse />
            </div>
            <span
              class="text-xs sm:text-sm font-medium text-light/60 group-hover:text-light transition-colors duration-300 text-center max-w-[160px] leading-snug"
            >
              Ciencias de la salud
            </span>
          </div>

          {/* Area 2: Ciencias Naturales */}
          <div class="flex flex-col items-center gap-4 group cursor-default">
            <div
              class="w-16 h-16 bg-light/5 border border-light/10 rounded-2xl flex items-center justify-center text-light/50 group-hover:text-jsyellow group-hover:border-jsyellow/40 transition-all duration-300"
            >
              <Leaf />
            </div>
            <span
              class="text-xs sm:text-sm font-medium text-light/60 group-hover:text-light transition-colors duration-300 text-center max-w-[160px] leading-snug"
            >
              Ciencias naturales
            </span>
          </div>

          {/* Area 3: Ingenierías */}
          <div class="flex flex-col items-center gap-4 group cursor-default">
            <div
              class="w-16 h-16 bg-light/5 border border-light/10 rounded-2xl flex items-center justify-center text-light/50 group-hover:text-jsyellow group-hover:border-jsyellow/40 transition-all duration-300"
            >
              <Cpu />
            </div>
            <span
              class="text-xs sm:text-sm font-medium text-light/60 group-hover:text-light transition-colors duration-300 text-center max-w-[160px] leading-snug"
            >
              Ingenierías
            </span>
          </div>

          {/* Area 4: Ciencias Sociales y Políticas */}
          <div class="flex flex-col items-center gap-4 group cursor-default">
            <div
              class="w-16 h-16 bg-light/5 border border-light/10 rounded-2xl flex items-center justify-center text-light/50 group-hover:text-jsyellow group-hover:border-jsyellow/40 transition-all duration-300"
            >
              <Scale />
            </div>
            <span
              class="text-xs sm:text-sm font-medium text-light/60 group-hover:text-light transition-colors duration-300 text-center max-w-[160px] leading-snug"
            >
              Ciencias sociales y políticas
            </span>
          </div>
        </div>
      </div>

      <!-- Action Footer -->
      <div class="flex flex-wrap items-center gap-4 text-sm text-light/60">
        <span>¿Quieres participar en el encuentro?</span>
        <a
          href="/registro"
          class="px-6 py-2 rounded-full border border-jsyellow text-light hover:bg-jsyellow hover:text-dark transition-all duration-300 font-medium tracking-wide"
        >
          Participar
        </a>
      </div>
    </div>
  </div>
</section>
