---
import * as Icons from 'lucide-react';
import { fetchConfig, fetchThematicLines, fetchEventTickets } from '../../lib/supabase';

const config = await fetchConfig();
const editionId = config.edition?.id || '';
const eventName = config.event?.name || 'III Encuentro Científico';

// Fetch thematic lines and tickets
const thematicLines = editionId ? await fetchThematicLines(editionId) : [];
const dbTickets = editionId ? await fetchEventTickets(editionId) : [];

// Category Formatter
function formatCategory(name: string): string {
  const norm = name.toUpperCase();
  if (norm === 'PREGADO' || norm === 'PREGRADO') return 'Pregrado';
  if (norm === 'POSTGRADO') return 'Postgrado';
  if (norm === 'PUBLICO GENERAL') return 'Público General';
  return name;
}

// Section texts from database settings
const sectionSettings = config.event?.settings?.landing_sections?.about;
const tagline = sectionSettings?.tagline || '— Escuela de Postgrado';
const heading =
  sectionSettings?.heading ||
  'Encuentro — espacio de convergencia para difundir e impulsar la investigación científica en la Amazonía.';

// Date Formatter
let formattedDates = '02 y 03 de julio de 2026';
if (config.edition?.start_date && config.edition?.end_date) {
  try {
    const start = new Date(config.edition.start_date + 'T00:00:00');
    const end = new Date(config.edition.end_date + 'T00:00:00');
    const startDay = String(start.getDate()).padStart(2, '0');
    const endDay = String(end.getDate()).padStart(2, '0');
    const startMonth = start.toLocaleDateString('es-ES', { month: 'long' });
    const endMonth = end.toLocaleDateString('es-ES', { month: 'long' });
    const startYear = start.getFullYear();
    const endYear = end.getFullYear();

    if (startYear !== endYear) {
      formattedDates = `${startDay} de ${startMonth}, ${startYear} al ${endDay} de ${endMonth}, ${endYear}`;
    } else if (startMonth !== endMonth) {
      formattedDates = `${startDay} de ${startMonth} al ${endDay} de ${endMonth}, ${startYear}`;
    } else if (startDay !== endDay) {
      formattedDates = `${startDay} y ${endDay} de ${startMonth}, ${startYear}`;
    } else {
      formattedDates = `${startDay} de ${startMonth}, ${startYear}`;
    }
  } catch (e) {
    console.error('Error formatting dates:', e);
  }
}

// Split heading into bold & regular parts for aesthetics
let boldTitle = 'Encuentro —';
let regularTitle =
  'espacio de convergencia para difundir e impulsar la investigación científica en la Amazonía.';

if (heading.includes(' — ')) {
  const parts = heading.split(' — ');
  boldTitle = parts[0] + ' —';
  regularTitle = parts.slice(1).join(' — ');
} else if (heading.includes(' - ')) {
  const parts = heading.split(' - ');
  boldTitle = parts[0] + ' -';
  regularTitle = parts.slice(1).join(' - ');
} else {
  boldTitle = '';
  regularTitle = heading;
}

// Modality and location mapping
const modalityText = config.edition?.modality
  ? config.edition.modality.toLowerCase().replace('modalidad ', '')
  : 'presencial y virtual';
const locationText = config.edition?.location || 'Escuela de Postgrado';

// Final paragraph
const paragraph = sectionSettings?.paragraph
  ? `El ${eventName} es un evento que se llevará a cabo de forma ${modalityText} en la ${locationText} el ${formattedDates}. ${sectionSettings.paragraph}`
  : `El ${eventName} es un evento que se llevará a cabo de forma ${modalityText} en la ${locationText} el ${formattedDates}. Está especialmente dirigido a investigadores, docentes, estudiantes de pregrado y postgrado, y profesionales dedicados a la construcción de conocimiento para la región.`;
---

<section
  id="sobre-evento"
  class="relative py-20 bg-dark overflow-hidden border-b border-white/[0.03]"
>
  <!-- Subtle decorative grid lines background -->
  <div
    class="absolute inset-0 bg-[linear-gradient(to_bottom,rgba(255,255,255,0.01)_1px,transparent_1px)] bg-[size:100%_40px] pointer-events-none opacity-25"
  >
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left Column: Core Info -->
      <div class="lg:col-span-7 flex flex-col">
        <!-- Tagline & Heading -->
        <div class="relative pl-6 mb-8 border-l-2 border-jsyellow/50">
          <span
            class="text-[11px] font-mono tracking-widest text-jsyellow uppercase block mb-3 font-semibold"
          >
            {tagline}
          </span>
          <h2
            class="font-display font-bold text-2xl sm:text-3xl md:text-4xl uppercase text-light leading-tight tracking-tight"
          >
            {boldTitle ? boldTitle + ' ' : ''}<span class="text-light/50 font-medium"
              >{regularTitle}</span
            >
          </h2>
        </div>

        <!-- Description Paragraph -->
        <div class="mb-10 max-w-2xl">
          <p class="text-sm sm:text-base text-light/70 leading-relaxed font-sans">
            {paragraph}
          </p>
        </div>

        <!-- Topics / Insights Section (Thematic Lines) -->
        {
          thematicLines.length > 0 && (
            <div class="mb-10">
              <p class="text-xs sm:text-sm text-light/40 uppercase font-mono tracking-wider mb-5">
                Líneas Temáticas
              </p>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {thematicLines.map((line: any) => (
                  <div class="flex items-center gap-3.5 group cursor-default p-3 rounded-xl border border-white/[0.04] bg-white/[0.01] hover:bg-white/[0.03] hover:border-white/[0.08] transition-all duration-300">
                    <div class="w-5.5 h-5.5 rounded-full border border-jsyellow/40 flex items-center justify-center text-jsyellow shrink-0 transition-transform duration-300 group-hover:scale-105 group-hover:border-jsyellow bg-jsyellow/5">
                      <Icons.Check className="w-3 h-3" strokeWidth={3.5} />
                    </div>
                    <span class="text-xs sm:text-sm font-semibold text-light/70 group-hover:text-light transition-colors duration-300">
                      {line.name}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          )
        }

        <!-- Action Footer -->
        <div
          class="flex items-center gap-4 text-xs sm:text-sm text-light/50 border-t border-white/[0.05] pt-6"
        >
          <span>¿Quieres participar en el encuentro?</span>
          <a
            href="/registro"
            class="inline-flex items-center gap-1.5 px-5 py-2 rounded-xl border border-jsyellow/40 hover:border-jsyellow hover:bg-jsyellow text-light hover:text-dark font-medium transition-all duration-300"
          >
            Inscribirse al Evento
            <Icons.ArrowRight className="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

      <!-- Right Column: Pricing & Certifications right side card -->
      <div class="lg:col-span-5 w-full">
        {
          dbTickets.length > 0 && (
            <div class="bg-white/[0.02] border border-white/[0.05] rounded-3xl p-6 md:p-8 backdrop-blur-md relative overflow-hidden group">
              <div class="absolute -top-24 -right-24 w-48 h-48 bg-jsyellow/5 rounded-full blur-3xl pointer-events-none group-hover:bg-jsyellow/10 transition-colors duration-500" />

              <h3 class="text-xs uppercase tracking-widest text-light/40 font-mono mb-6">
                Derechos de Certificación
              </h3>

              <div class="flex flex-col gap-4">
                {dbTickets.map((ticket: any) => {
                  const category = formatCategory(ticket.name);
                  const isPopular = ticket.name.toUpperCase().includes('POSTGRADO');
                  return (
                    <div
                      class={`relative rounded-2xl p-5 border flex items-center justify-between transition-all duration-300 ${
                        isPopular
                          ? 'border-jsyellow/50 bg-jsyellow/[0.03]'
                          : 'border-white/[0.08] bg-white/[0.01] hover:border-white/[0.15]'
                      }`}
                    >
                      {isPopular && (
                        <span class="absolute -top-2.5 right-4 bg-jsyellow text-dark text-[9px] font-bold uppercase tracking-widest px-2.5 py-0.5 rounded-full font-mono">
                          Recomendado
                        </span>
                      )}
                      <div>
                        <span class="text-xs font-semibold text-light/80 uppercase tracking-wider block mb-1">
                          {category}
                        </span>
                        <span class="text-[10px] text-light/40 font-normal block">
                          Pago único por derecho de certificado firmado
                        </span>
                      </div>
                      <div class="flex items-baseline gap-0.5 text-light text-right">
                        <span class="text-xs font-semibold text-jsyellow">S/.</span>
                        <span class="text-xl font-bold font-sans">
                          {Number(ticket.price).toFixed(2)}
                        </span>
                      </div>
                    </div>
                  );
                })}
              </div>

              <p class="text-[10px] text-light/40 text-center mt-5 leading-relaxed">
                * Los costos de certificación corresponden a las tasas académicas vigentes del
                evento.
              </p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
