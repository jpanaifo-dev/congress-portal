---
import { RegistrationForm } from '../../features/registration/components/RegistrationForm';
---

<section id="registro" class="relative py-24 bg-dark/30">
  <!-- Soft forest lights -->
  <div
    class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary/10 rounded-full blur-3xl pointer-events-none"
  >
  </div>

  <div class="container mx-auto px-6 md:px-12 relative z-10">
    <!-- Section Header -->
    <div class="text-center mx-auto mb-16 flex flex-col gap-4">
      <span class="text-xs font-bold text-secondary uppercase tracking-widest">
        Formulario Digital
      </span>
      <h2 class="font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-light">
        Inscripción del Participante
      </h2>
      <p class="text-sm sm:text-base text-light/75 leading-relaxed">
        Separe su cupo académico registrando sus datos básicos. Posteriormente podrá registrar el
        comprobante de depósito bancario para formalizar la emisión de su certificado firmado.
      </p>
    </div>

    {/* Registration Form (loaded client-side immediately) */}
    <RegistrationForm client:load />
  </div>
</section>
