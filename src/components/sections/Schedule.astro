---
import { Timeline } from '../../features/home/components/Timeline';
import { fetchConfig, fetchSessions } from '../../lib/supabase';

const config = await fetchConfig();
const editionId = config.edition?.id || "";

// Verify sessions exist in DB
const sessions = editionId ? await fetchSessions(editionId) : [];
const hasSessions = sessions && sessions.length > 0;

const sectionSettings = config.event?.settings?.landing_sections?.schedule;
const tagline = sectionSettings?.tagline || "Cronograma Académico";
const title = sectionSettings?.title || "Programa Científico y Ponencias";
const description = sectionSettings?.description || "El Encuentro se estructurará en conferencias magistrales, mesas redondas, y exposiciones de avances de tesis organizados por áreas científicas.";
---

{hasSessions && (
  <section id="cronograma" class="relative py-24 bg-dark schedule-crowd-bg">
    <!-- Soft forest green glow -->
    <div
      class="absolute top-0 right-1/4 w-96 h-96 bg-primary/10 rounded-full blur-3xl pointer-events-none"
    >
    </div>

    <div class="container mx-auto px-6 md:px-12 relative z-10">
      <!-- Section Header -->
      <div class="text-center mx-auto mb-16 flex flex-col gap-4">
        <span class="text-xs font-bold text-secondary uppercase tracking-widest">
          {tagline}
        </span>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-light">
          {title}
        </h2>
        <p class="text-sm sm:text-base text-light/75 leading-relaxed">
          {description}
        </p>
      </div>


      {/* Timeline Component Embed (loaded when visible to user) */}
      <Timeline client:visible editionId={editionId} />

      {/* CTA to complete program page */}
      <div class="text-center mt-12">
        <a
          href="/programa"
          class="inline-flex items-center gap-2 text-sm font-bold bg-light text-secondary hover:text-accent border border-secondary/20 hover:border-accent/40 bg-transparent py-3 px-8 rounded-full transition-all cursor-pointer hover:shadow-lg hover:shadow-secondary/5 active:scale-98"
        >
          Ver Cronograma Completo
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
)}

