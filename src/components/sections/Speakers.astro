---
import { SpeakersList } from '../../features/home/components/SpeakersList';
import { fetchConfig, fetchSpeakers } from '../../lib/supabase';

const config = await fetchConfig();
const editionId = config.edition?.id || "";

// Verify speakers exist in DB
const speakers = editionId ? await fetchSpeakers(editionId) : [];
const hasSpeakers = speakers && speakers.length > 0;

const sectionSettings = config.event?.settings?.landing_sections?.speakers;
const tagline = sectionSettings?.tagline || "Ponentes e Invitados";
const title = sectionSettings?.title || "Investigadores y Líderes Académicos";
const description = sectionSettings?.description || "Contamos con la participación de destacados científicos de nivel internacional, especialistas en conservación, medicina tropical, ciencia de datos y gobernanza territorial.";
---

{hasSpeakers && (
  <section id="ponentes" class="relative py-24 bg-dark/30 overflow-hidden">
    <!-- Glowing forest ambient backdrop -->
    <div
      class="absolute top-1/4 right-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none"
    >
    </div>
    <div
      class="absolute bottom-1/4 left-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none"
    >
    </div>

    <div class="container mx-auto px-6 md:px-12 relative z-10">
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
        <div class="flex flex-col gap-3 max-w-2xl text-left">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">
            {tagline}
          </span>
          <h2 class="font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-light leading-tight">
            {title}
          </h2>
          <p class="text-sm sm:text-base text-light/70 leading-relaxed mt-1">
            {description}
          </p>
        </div>
        <div class="shrink-0 flex items-center">
          <a
            href="/programa"
            class="inline-flex items-center gap-2.5 text-xs font-bold text-light border border-light/15 hover:border-secondary/40 bg-light/5 dark:bg-white/5 hover:bg-light/10 dark:hover:bg-white/10 py-3.5 px-6 rounded-full transition-all duration-300 hover:shadow-lg active:scale-98 cursor-pointer shrink-0"
          >
            Ver todos los ponentes
          </a>
        </div>
      </div>


      <!-- Speakers Grid (Dynamically loaded from Database) -->
      <SpeakersList client:visible editionId={editionId} />
    </div>
  </section>
)}

