---
import { Calendar, MapPin, ArrowRight, BookOpen, GraduationCap } from 'lucide-react';
import { Countdown } from '../../features/home/components/Countdown';
import { fetchConfig } from '../../lib/supabase';

const config = await fetchConfig();
const eventName = config.event?.name || "III Encuentro Científico de la Escuela de Postgrado";
const shortDescription = config.event?.short_description || "Ciencia que transforma la Amazonía, conocimiento que construye futuro";

let formattedDates = "02 y 03 de Julio, 2026";
if (config.edition?.start_date && config.edition?.end_date) {
  try {
    const start = new Date(config.edition.start_date + 'T00:00:00');
    const end = new Date(config.edition.end_date + 'T00:00:00');
    const startDay = String(start.getDate()).padStart(2, '0');
    const endDay = String(end.getDate()).padStart(2, '0');
    const startMonth = start.toLocaleDateString('es-ES', { month: 'long' });
    const endMonth = end.toLocaleDateString('es-ES', { month: 'long' });
    const startYear = start.getFullYear();
    const endYear = end.getFullYear();

    if (startYear !== endYear) {
      formattedDates = `${startDay} de ${startMonth}, ${startYear} al ${endDay} de ${endMonth}, ${endYear}`;
    } else if (startMonth !== endMonth) {
      formattedDates = `${startDay} de ${startMonth} al ${endDay} de ${endMonth}, ${startYear}`;
    } else if (startDay !== endDay) {
      const capMonth = startMonth.charAt(0).toUpperCase() + startMonth.slice(1);
      formattedDates = `${startDay} y ${endDay} de ${capMonth}, ${startYear}`;
    } else {
      const capMonth = startMonth.charAt(0).toUpperCase() + startMonth.slice(1);
      formattedDates = `${startDay} de ${capMonth}, ${startYear}`;
    }
  } catch (e) {
    console.error('Error formatting dates:', e);
  }
}
---

<section
  id="inicio"
  class="dark relative min-h-screen flex items-center justify-start pt-28 pb-16 overflow-hidden"
>
  <!-- Video Background and Fallback Poster Image -->
  <div class="absolute inset-0 z-0 select-none pointer-events-none">
    <video
      autoplay
      loop
      muted
      playsinline
      poster={config.event?.cover_url || "https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&q=80&w=1600&h=900"}
      class="absolute inset-0 w-full h-full object-cover filter grayscale contrast-110 brightness-[0.35] saturate-[0.60]"
    >
      <source src="/videos/banner_video.mp4" type="video/mp4" />
    </video>
  </div>

  <!-- Subtle Rainforest dot leaf texture overlay -->
  <div class="absolute inset-0 leaf-overlay pointer-events-none z-[1] opacity-5"></div>

  <div
    class="container mx-auto px-6 md:px-12 relative z-10 w-full flex flex-col justify-between min-h-[75vh]"
  >
    <!-- Left Aligned Content Wrapper (No Right Column) -->
    <div class="max-w-3xl flex flex-col gap-6 text-left my-auto">
      <h1
        class="font-display font-black text-4xl sm:text-5xl lg:text-6xl leading-tight tracking-tight text-white uppercase"
      >
        {eventName}
      </h1>

      <div class="flex flex-col gap-2 border-l-2 border-secondary pl-4 py-1">
        <p class="text-sm sm:text-lg italic max-w-2xl text-white/80">
          "{shortDescription}"
        </p>
      </div>

      {/* Countdown Timer nested directly in Left Column */}
      <Countdown client:load />
    </div>

    {/* Bottom Bar: Location/Dates on the Left, Actions on the Right */}
    <div
      class="w-full flex flex-col lg:flex-row items-center justify-between gap-6 border-t border-accent/15 pt-8 mt-12"
    >
      <!-- Joined Location/Date Capsule - Faithful to User Screenshot -->
      <div class="shrink-0">
        <div
          class="inline-flex items-center border border-secondary rounded-full overflow-hidden p-0.5 bg-black/40 backdrop-blur-sm"
        >
          <div
            class="inline-flex items-center gap-2 bg-secondary text-[#0D1F17] text-xs sm:text-sm font-black uppercase tracking-wider px-5 py-2.5 rounded-full shrink-0"
          >
            <svg class="w-4.5 h-3.5 rounded-sm border border-black/10 shrink-0" viewBox="0 0 3 2">
              <rect width="1" height="2" fill="#d91414"></rect>
              <rect width="1" height="2" x="1" fill="#fff"></rect>
              <rect width="1" height="2" x="2" fill="#d91414"></rect>
            </svg>
            Iquitos
          </div>
          <span
            class="text-xs sm:text-sm text-white font-display font-bold px-5 py-2.5 whitespace-nowrap underline decoration-secondary decoration-2 underline-offset-4"
          >
            {formattedDates}
          </span>
        </div>
      </div>

      <!-- Action CTAs -->
      <div class="flex flex-col sm:flex-row items-center gap-5 w-full lg:w-auto">
        <a
          href="/registro"
          class="w-full sm:w-auto text-center inline-flex items-center justify-center font-display font-black text-base uppercase tracking-wider text-[#0D1F17] bg-secondary hover:bg-accent px-12 py-5 rounded-full transition-all cursor-pointer shadow-lg shadow-secondary/15 hover:shadow-secondary/25 active:scale-98"
        >
          INSCRÍBETE
        </a>
        <a
          href="#cronograma"
          class="w-full sm:w-auto text-center inline-flex items-center justify-center font-display font-black text-base uppercase tracking-wider text-white hover:text-[#0D1F17] hover:bg-white bg-transparent border border-white/20 hover:border-transparent px-12 py-5 rounded-full transition-all cursor-pointer active:scale-98"
        >
          Ver programa
        </a>
      </div>
    </div>
  </div>
</section>
