---
import { Calendar, MapPin, ArrowRight, BookOpen, GraduationCap } from 'lucide-react';
import { Countdown } from '../../features/home/components/Countdown';
import { fetchConfig } from '../../lib/supabase';

const config = await fetchConfig();
const eventName = config.event?.name || "III Encuentro Científico de la Escuela de Postgrado";
const shortDescription = config.event?.short_description || "Sin descripcion";

// Dynamic splitting for heading styling (first words are bold, rest are regular/medium weight)
const titleWords = eventName.split(' ');
let boldPart = eventName;
let regularPart = "";
if (titleWords.length > 2) {
  const splitIndex = Math.min(3, Math.ceil(titleWords.length / 2));
  boldPart = titleWords.slice(0, splitIndex).join(' ');
  regularPart = titleWords.slice(splitIndex).join(' ');
}

// Fetch location, modality and edition title dynamically from database, fallback if not set yet
const eventLocation = config.edition?.location || config.event?.location || "Iquitos, Perú";
const eventModality = config.edition?.modality || config.event?.modality || "Modalidad Híbrida";
const editionTitle = config.edition?.name?.es || "Tercera Edición";

let formattedDates = "02 y 03 de Julio, 2026";
if (config.edition?.start_date && config.edition?.end_date) {
  try {
    const start = new Date(config.edition.start_date + 'T00:00:00');
    const end = new Date(config.edition.end_date + 'T00:00:00');
    const startDay = String(start.getDate()).padStart(2, '0');
    const endDay = String(end.getDate()).padStart(2, '0');
    const startMonth = start.toLocaleDateString('es-ES', { month: 'long' });
    const endMonth = end.toLocaleDateString('es-ES', { month: 'long' });
    const startYear = start.getFullYear();
    const endYear = end.getFullYear();

    if (startYear !== endYear) {
      formattedDates = `${startDay} de ${startMonth}, ${startYear} al ${endDay} de ${endMonth}, ${endYear}`;
    } else if (startMonth !== endMonth) {
      formattedDates = `${startDay} de ${startMonth} al ${endDay} de ${endMonth}, ${startYear}`;
    } else if (startDay !== endDay) {
      const capMonth = startMonth.charAt(0).toUpperCase() + startMonth.slice(1);
      formattedDates = `${startDay} y ${endDay} de ${capMonth}, ${startYear}`;
    } else {
      const capMonth = startMonth.charAt(0).toUpperCase() + startMonth.slice(1);
      formattedDates = `${startDay} de ${capMonth}, ${startYear}`;
    }
  } catch (e) {
    console.error('Error formatting dates:', e);
  }
}
---

<section
  id="inicio"
  class="dark relative min-h-screen flex items-center justify-start pt-28 pb-16 overflow-hidden"
>
  <!-- Video Background and Fallback Poster Image -->
  <div class="absolute inset-0 z-0 select-none pointer-events-none">
    <video
      autoplay
      loop
      muted
      playsinline
      poster={config.event?.cover_url || "https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&q=80&w=1600&h=900"}
      class="absolute inset-0 w-full h-full object-cover filter grayscale contrast-110 brightness-[0.35] saturate-[0.60]"
    >
      <source src="/videos/banner_video.mp4" type="video/mp4" />
    </video>
  </div>

  <!-- Subtle Rainforest dot leaf texture overlay -->
  <div class="absolute inset-0 leaf-overlay pointer-events-none z-[1] opacity-5"></div>

  <div
    class="container mx-auto px-6 md:px-12 relative z-10 w-full flex flex-col justify-center min-h-[85vh] pt-12"
  >
    <!-- Left Aligned Content Wrapper (No Right Column) -->
    <div class="max-w-5xl flex flex-col gap-6 text-left my-auto">
      
      <!-- Edition Header Eyebrow Tag -->
      <div class="w-fit flex items-center gap-2 bg-secondary/15 text-secondary border border-secondary/25 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest">
        Edición: {editionTitle}
      </div>

      <h1
        class="font-display text-5xl sm:text-7xl leading-[0.9] tracking-tight text-white uppercase max-w-4xl"
      >
        <span class="font-black">{boldPart}</span>{" "}
        <span class="font-medium text-white/80">{regularPart}</span>
      </h1>

      <div class="flex flex-col gap-2 border-l border-white/20 pl-4 py-1.5 max-w-3xl">
        <p class="text-sm sm:text-base md:text-lg italic text-white/80 font-medium">
          "{shortDescription}"
        </p>
      </div>

      <!-- Joined Location/Date Capsule badges - Modern minimal conference style -->
      <div class="flex flex-wrap items-center gap-3 sm:gap-4 text-xs font-bold uppercase tracking-widest text-white/90 mt-4">
        <!-- Date Badge -->
        <div class="flex items-center gap-2 bg-white/5 backdrop-blur-md border border-white/10 px-4 py-2.5 rounded-full">
          <span class="inline-block w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
          <span>Fecha: {formattedDates}</span>
        </div>
        <!-- Location Badge -->
        <div class="flex items-center gap-2 bg-white/5 backdrop-blur-md border border-white/10 px-4 py-2.5 rounded-full">
          <svg class="w-4 h-2.5 rounded-sm border border-white/10 shrink-0" viewBox="0 0 3 2">
            <rect width="1" height="2" fill="#d91414"></rect>
            <rect width="1" height="2" x="1" fill="#fff"></rect>
            <rect width="1" height="2" x="2" fill="#d91414"></rect>
          </svg>
          <span>Lugar: {eventLocation}</span>
        </div>
        <!-- Modality Badge -->
        <div class="flex items-center gap-2 bg-white/5 backdrop-blur-md border border-white/10 px-4 py-2.5 rounded-full">
          <span>Modalidad: {eventModality}</span>
        </div>
      </div>

      <!-- Action CTAs (Toggled via CSS depending on Sticky Bottom Banner status) -->
      <div id="hero-actions" class="flex flex-col sm:flex-row items-center gap-4 mt-8 w-full sm:w-auto transition-all duration-300 ease-in-out">
        <a
          href="/registro"
          class="w-full sm:w-auto text-center inline-flex items-center justify-center font-display font-bold text-xs uppercase tracking-widest text-[#0D1F17] bg-secondary hover:bg-accent px-10 py-4.5 rounded-full transition-all cursor-pointer shadow-lg shadow-secondary/15 hover:shadow-secondary/25 active:scale-98"
        >
          Inscribirse
        </a>
        <a
          href="#cronograma"
          class="w-full sm:w-auto text-center inline-flex items-center justify-center font-display font-bold text-xs uppercase tracking-widest text-white hover:text-[#0D1F17] hover:bg-white bg-transparent border border-white/20 hover:border-transparent px-10 py-4.5 rounded-full transition-all cursor-pointer active:scale-98"
        >
          Ver programa
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Astro Scoped Styles: Hide Hero actions smoothly when sticky bottom banner is active */
  :global(html.sticky-banner-active) #hero-actions {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    height: 0;
    margin-top: 0;
    padding-top: 0;
    overflow: hidden;
  }
</style>
