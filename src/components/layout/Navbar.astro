---
import { Menu, X } from 'lucide-react';

const navLinks = [
  { href: '#inicio', label: 'Inicio' },
  { href: '#sobre-evento', label: 'Sobre el Evento' },
  { href: '#cronograma', label: 'Programa' },
  { href: '#ponentes', label: 'Ponentes' },
  { href: '#tarifas', label: 'Inversión' },
  { href: '#faq', label: 'FAQ' },
  { href: '#contacto', label: 'Contacto' },
  { href: '#registro', label: 'Registro' },
];
---

<header
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 py-4 px-6 md:px-12"
>
  <div class="container mx-auto flex items-center justify-between">
    <!-- Logo -->
    <a
      href="#inicio"
      class="flex items-center focus-visible:outline-2 focus-visible:outline-accent rounded-lg"
      aria-label="Volver al inicio"
    >
      <img
        src="/images/postgrado_brandwhite.webp"
        alt="Escuela de Postgrado UNAP"
        class="h-10 w-auto object-contain transition-transform hover:scale-[1.02] duration-300"
      />
    </a>

    <!-- Desktop Nav Links (Minimalist, flat matching JSNation) -->
    <nav class="hidden lg:flex items-center gap-6">
      {
        navLinks.map((link, index) => {
          const isRegister = link.href === '#registro';
          return (
            <a
              href={link.href}
              class={`font-display text-sm tracking-wide transition-all focus-visible:outline-none focus-visible:underline underline-offset-4 ${
                isRegister
                  ? 'text-secondary hover:text-accent font-bold'
                  : 'text-white/80 hover:text-white'
              }`}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Mobile Navigation Toggle Button -->
    <button
      id="mobile-nav-toggle"
      class="lg:hidden p-2 text-light/90 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-lg"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-nav-menu"
    >
      <Menu id="icon-menu" />
      <X id="icon-close" />
    </button>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-nav-menu"
    class="fixed inset-0 top-[72px] bg-dark/95 backdrop-blur-xl border-t border-accent/10 transition-all duration-300 translate-x-full lg:hidden flex flex-col p-6 z-40"
    role="dialog"
    aria-label="Menú móvil"
  >
    <nav class="flex flex-col gap-3">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link font-display text-xl font-medium text-light/90 hover:text-white py-3 border-b border-accent/5 transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="mt-8">
      <a
        href="#registro"
        class="mobile-nav-link w-full text-center inline-block font-display font-semibold text-dark bg-secondary hover:bg-accent py-4 rounded-xl transition-colors shadow-lg shadow-secondary/10"
      >
        Registrarse ahora
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('main-header');
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-nav-menu');
  const menuIcon = document.getElementById('icon-menu');
  const closeIcon = document.getElementById('icon-close');
  const links = document.querySelectorAll('.mobile-nav-link');

  // Sticky header class injection
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header?.classList.add(
        'bg-dark/80',
        'backdrop-blur-lg',
        'border-b',
        'border-accent/10',
        'py-3'
      );
      header?.classList.remove('py-4');
    } else {
      header?.classList.remove(
        'bg-dark/80',
        'backdrop-blur-lg',
        'border-b',
        'border-accent/10',
        'py-3'
      );
      header?.classList.add('py-4');
    }
  });

  // Toggle drawer state
  function toggleMenu() {
    const isExpanded = toggleBtn?.getAttribute('aria-expanded') === 'true';
    toggleBtn?.setAttribute('aria-expanded', (!isExpanded).toString());

    if (isExpanded) {
      menu?.classList.add('translate-x-full');
      menu?.classList.remove('translate-x-0');
      menuIcon?.classList.add('block');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      closeIcon?.classList.remove('block');
      document.body.style.overflow = '';
    } else {
      menu?.classList.add('translate-x-0');
      menu?.classList.remove('translate-x-full');
      menuIcon?.classList.add('hidden');
      menuIcon?.classList.remove('block');
      closeIcon?.classList.add('block');
      closeIcon?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  }

  toggleBtn?.addEventListener('click', toggleMenu);

  // Close when clicking any link
  links.forEach((link) => {
    link.addEventListener('click', () => {
      if (toggleBtn?.getAttribute('aria-expanded') === 'true') {
        toggleMenu();
      }
    });
  });
</script>
