---
import { Menu, X } from 'lucide-react';

const navLinks = [
  { href: '#inicio', label: 'Inicio' },
  { href: '#sobre-evento', label: 'Sobre el Evento' },
  { href: '#cronograma', label: 'Programa' },
  { href: '#ponentes', label: 'Ponentes' },
  { href: '#tarifas', label: 'Inversión' },
  { href: '#faq', label: 'FAQ' },
  { href: '#contacto', label: 'Contacto' },
  { href: '/registro', label: 'Registro' },
];
---

<header
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 py-4 px-6 md:px-12 bg-transparent border-b border-transparent dark"
>
  <div class="container mx-auto flex items-center justify-between">
    <!-- Logo -->
    <a
      href="#inicio"
      class="flex items-center focus-visible:outline-2 focus-visible:outline-accent rounded-lg"
      aria-label="Volver al inicio"
    >
      <img
        src="/images/postgrado_brandwhite.webp"
        alt="Escuela de Postgrado UNAP"
        class="h-10 w-auto object-contain transition-transform hover:scale-[1.02] duration-300"
      />
    </a>

    <!-- Desktop Nav Links (Minimalist, flat matching JSNation) -->
    <nav class="hidden lg:flex items-center gap-6">
      {
        navLinks.map((link, index) => {
          const isRegister = link.href === '#registro' || link.href === '/registro';
          return (
            <a
              href={link.href}
              class={`font-display text-sm tracking-wide transition-all focus-visible:outline-none focus-visible:underline underline-offset-4 ${
                isRegister
                  ? 'text-secondary hover:text-accent font-bold'
                  : 'text-light/80 hover:text-light nav-link-item'
              }`}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Right Side Actions (Theme Toggle + Mobile Nav Toggle) -->
    <div class="flex items-center gap-3">
      <!-- Theme Toggle IconButton -->
      <button
        id="theme-toggle"
        class="p-2.5 text-light/80 hover:text-light hover:bg-light/10 border border-light/10 rounded-xl transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary"
        aria-label="Cambiar tema de color"
      >
        <!-- Moon Icon (shown in light mode, hidden in dark mode) -->
        <svg
          id="theme-toggle-dark-icon"
          class="w-5 h-5 hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
        <!-- Sun Icon (shown in dark mode, hidden in light mode) -->
        <svg
          id="theme-toggle-light-icon"
          class="w-5 h-5 hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707.707M12 8a4 4 0 100 8 4 4 0 000-8z"
          ></path>
        </svg>
      </button>

      <!-- Mobile Navigation Toggle Button -->
      <button
        id="mobile-nav-toggle"
        class="lg:hidden p-2 text-light/90 hover:text-light hover:bg-light/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-lg"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-nav-menu"
      >
        <Menu id="icon-menu" />
        <X id="icon-close" />
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-nav-menu"
    class="fixed inset-0 top-[72px] bg-dark/95 backdrop-blur-xl border-t border-accent/10 transition-all duration-300 translate-x-full lg:hidden flex flex-col p-6 z-40"
    role="dialog"
    aria-label="Menú móvil"
  >
    <nav class="flex flex-col gap-3">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link font-display text-xl font-medium text-light/90 hover:text-light py-3 border-b border-accent/5 transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="mt-8">
      <a
        href="/registro"
        class="mobile-nav-link w-full text-center inline-block font-display font-semibold text-dark bg-secondary hover:bg-accent py-4 rounded-xl transition-colors shadow-lg shadow-secondary/10"
      >
        Registrarse ahora
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('main-header');
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-nav-menu');
  const menuIcon = document.getElementById('icon-menu');
  const closeIcon = document.getElementById('icon-close');
  const links = document.querySelectorAll('.mobile-nav-link');

  const themeToggleBtn = document.getElementById('theme-toggle');
  const darkIcon = document.getElementById('theme-toggle-dark-icon');
  const lightIcon = document.getElementById('theme-toggle-light-icon');

  // Theme icons visibility updater
  function updateToggleIcons() {
    if (document.documentElement.classList.contains('dark')) {
      darkIcon?.classList.add('hidden');
      lightIcon?.classList.remove('hidden');
    } else {
      darkIcon?.classList.remove('hidden');
      lightIcon?.classList.add('hidden');
    }
  }

  // Initial update
  updateToggleIcons();

  // Listen to toggle clicks
  themeToggleBtn?.addEventListener('click', () => {
    if (document.documentElement.classList.contains('dark')) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
    updateToggleIcons();
  });

  const hasHero = document.getElementById('inicio') !== null;

  // Sticky header class injection
  function handleScroll() {
    if (!hasHero) {
      header?.classList.add('bg-dark', 'border-accent/10', 'py-3');
      header?.classList.remove('bg-transparent', 'border-transparent', 'py-4', 'dark');
      return;
    }

    if (window.scrollY > 20) {
      header?.classList.add('bg-dark', 'border-accent/10', 'py-3');
      header?.classList.remove('bg-transparent', 'border-transparent', 'py-4', 'dark');
    } else {
      header?.classList.add('bg-transparent', 'border-transparent', 'py-4', 'dark');
      header?.classList.remove('bg-dark', 'border-accent/10', 'py-3');
    }
  }

  window.addEventListener('scroll', handleScroll);
  handleScroll();

  // Toggle drawer state
  function toggleMenu() {
    const isExpanded = toggleBtn?.getAttribute('aria-expanded') === 'true';
    toggleBtn?.setAttribute('aria-expanded', (!isExpanded).toString());

    if (isExpanded) {
      menu?.classList.add('translate-x-full');
      menu?.classList.remove('translate-x-0');
      menuIcon?.classList.add('block');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      closeIcon?.classList.remove('block');
      document.body.style.overflow = '';
    } else {
      menu?.classList.add('translate-x-0');
      menu?.classList.remove('translate-x-full');
      menuIcon?.classList.add('hidden');
      menuIcon?.classList.remove('block');
      closeIcon?.classList.add('block');
      closeIcon?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  }

  toggleBtn?.addEventListener('click', toggleMenu);

  // Close when clicking any link
  links.forEach((link) => {
    link.addEventListener('click', () => {
      if (toggleBtn?.getAttribute('aria-expanded') === 'true') {
        toggleMenu();
      }
    });
  });
</script>

<style>
  /* When the navbar is transparent over the dark video (at the start), option links are always white */
  #main-header.dark .nav-link-item {
    color: rgba(255, 255, 255, 0.8) !important;
  }
  #main-header.dark .nav-link-item:hover {
    color: #ffffff !important;
  }

  /* Force mobile menu links to follow global page theme, ignoring header's own .dark state */
  html:not(.dark) #main-header .mobile-nav-link:not(.bg-secondary) {
    color: #0d1f17 !important;
  }
  html:not(.dark) #main-header .mobile-nav-link:not(.bg-secondary):hover {
    color: #0b5d1e !important;
  }
  html.dark #main-header .mobile-nav-link:not(.bg-secondary) {
    color: #f5f8f5 !important;
  }
  html.dark #main-header .mobile-nav-link:not(.bg-secondary):hover {
    color: #ffffff !important;
  }
</style>
