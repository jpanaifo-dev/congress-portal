---
import { FooterReact } from './FooterReact';
import { fetchConfig } from '../../lib/supabase';
import { CONTACT_INFO } from '../../constants/eventData';

const config = await fetchConfig();
const logoUrl = config.event?.logo_url || "/images/postgrado_brandwhite.webp";
const eventName = config.event?.name || "Escuela de Postgrado UNAP";

const contactInfo = {
  address: config.event?.location || CONTACT_INFO.address,
  phones: CONTACT_INFO.phones,
  emails: config.event?.contact_email ? [config.event.contact_email] : CONTACT_INFO.emails
};
---

<FooterReact logoUrl={logoUrl} eventName={eventName} contactInfo={contactInfo} client:visible />
