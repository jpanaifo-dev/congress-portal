---
import {
  Leaf,
  GraduationCap,
  Mail,
  Phone,
  MapPin,
  Facebook,
  Youtube,
  Linkedin,
  ArrowUpRight,
} from 'lucide-react';
import { CONTACT_INFO } from '../../constants/eventData';

const currentYear = new Date().getFullYear();
---

<footer class="bg-dark border-t border-accent/10 relative overflow-hidden pt-16 pb-8 px-6 md:px-12">
  <!-- Decorative Background Leaf -->
  <div
    class="absolute bottom-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none translate-x-1/3 translate-y-1/3"
  >
  </div>

  <div class="container mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 relative z-10">
    <!-- Col 1: University Branding & Socials -->
    <div class="flex flex-col gap-6">
      <div class="flex items-center gap-3">
        <div
          class="w-10 h-10 bg-primary/20 rounded-xl flex items-center justify-center border border-primary/30"
        >
          <Leaf class="w-5 h-5 text-secondary absolute top-1.5 right-1.5" />
          <GraduationCap class="w-6 h-6 text-accent absolute bottom-1.5 left-1.5" />
        </div>
        <div class="flex flex-col">
          <span class="font-display font-bold text-lg leading-tight text-white"
            >Escuela de Postgrado</span
          >
          <span class="text-xs text-accent font-medium uppercase tracking-widest">UNAP</span>
        </div>
      </div>
      <p class="text-sm text-light/70 leading-relaxed">
        Impulsando la investigación de alto impacto en la Amazonía peruana, formando investigadores
        de excelencia y construyendo el desarrollo sostenible.
      </p>
      <!-- Social Media Links -->
      <div class="flex items-center gap-3 mt-2">
        <a
          href="https://facebook.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2.5 bg-primary/10 hover:bg-primary/20 text-accent hover:text-white rounded-lg border border-accent/10 transition-colors"
          aria-label="Facebook Oficial de la Escuela de Postgrado"
        >
          <Facebook class="w-5 h-5" />
        </a>
        <a
          href="https://youtube.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2.5 bg-primary/10 hover:bg-primary/20 text-accent hover:text-white rounded-lg border border-accent/10 transition-colors"
          aria-label="Canal de Youtube de la Escuela de Postgrado"
        >
          <Youtube class="w-5 h-5" />
        </a>
        <a
          href="https://linkedin.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2.5 bg-primary/10 hover:bg-primary/20 text-accent hover:text-white rounded-lg border border-accent/10 transition-colors"
          aria-label="Página de LinkedIn de la Escuela de Postgrado"
        >
          <Linkedin class="w-5 h-5" />
        </a>
      </div>
    </div>

    <!-- Col 2: Useful Links -->
    <div class="flex flex-col gap-4">
      <h3
        class="font-display font-semibold text-white uppercase tracking-wider text-sm border-l-2 border-secondary pl-3"
      >
        Enlaces de Interés
      </h3>
      <nav class="flex flex-col gap-2.5 text-sm">
        <a
          href="https://postgrado.unapiquitos.edu.pe"
          target="_blank"
          rel="noopener"
          class="text-light/70 hover:text-white flex items-center gap-1 group transition-colors"
        >
          Portal de Postgrado <ArrowUpRight
            class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity"
          />
        </a>
        <a
          href="https://www.unapiquitos.edu.pe"
          target="_blank"
          rel="noopener"
          class="text-light/70 hover:text-white flex items-center gap-1 group transition-colors"
        >
          Portal Principal UNAP <ArrowUpRight
            class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity"
          />
        </a>
        <a
          href="https://alicia.concytec.gob.pe"
          target="_blank"
          rel="noopener"
          class="text-light/70 hover:text-white flex items-center gap-1 group transition-colors"
        >
          Repositorio Nacional ALICIA <ArrowUpRight
            class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity"
          />
        </a>
        <a href="#cronograma" class="text-light/70 hover:text-white transition-colors">
          Programa del Encuentro
        </a>
        <a href="#registro" class="text-light/70 hover:text-white transition-colors">
          Ficha de Inscripción
        </a>
      </nav>
    </div>

    <!-- Col 3: Research Focus -->
    <div class="flex flex-col gap-4">
      <h3
        class="font-display font-semibold text-white uppercase tracking-wider text-sm border-l-2 border-secondary pl-3"
      >
        Líneas de Investigación
      </h3>
      <ul class="flex flex-col gap-2 text-sm text-light/70">
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
          Biodiversidad Amazónica
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
          Salud y Patologías Tropicales
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
          Bioingeniería y Tecnologías Limpias
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
          Políticas Públicas y Territorialidad
        </li>
      </ul>
    </div>

    <!-- Col 4: Contact Details -->
    <div class="flex flex-col gap-4">
      <h3
        class="font-display font-semibold text-white uppercase tracking-wider text-sm border-l-2 border-secondary pl-3"
      >
        Contacto Oficial
      </h3>
      <div class="flex flex-col gap-3.5 text-sm text-light/70">
        <div class="flex gap-2.5">
          <MapPin class="w-5 h-5 text-accent shrink-0" />
          <span>{CONTACT_INFO.address}</span>
        </div>
        <div class="flex items-center gap-2.5">
          <Phone class="w-4 h-4 text-accent shrink-0" />
          <span>{CONTACT_INFO.phones[0]}</span>
        </div>
        <div class="flex items-center gap-2.5">
          <Mail class="w-4 h-4 text-accent shrink-0" />
          <a href={`mailto:${CONTACT_INFO.emails[0]}`} class="hover:text-white transition-colors"
            >{CONTACT_INFO.emails[0]}</a
          >
        </div>
        <div
          class="mt-2 text-xs border border-primary/20 bg-primary/5 rounded-lg p-2.5 text-accent/80 font-medium"
        >
          Atención: Lunes a Viernes<br />08:00 AM - 02:00 PM
        </div>
      </div>
    </div>
  </div>

  <!-- Copyright and Bottom Info -->
  <div
    class="container mx-auto mt-16 pt-8 border-t border-accent/10 flex flex-col md:flex-row items-center justify-between gap-4 relative z-10 text-xs text-light/50"
  >
    <p>
      © {currentYear} Universidad Nacional de la Amazonía Peruana. Escuela de Postgrado. Todos los derechos
      reservados.
    </p>
    <div class="flex gap-6">
      <a href="#faq" class="hover:text-white transition-colors">Términos & Condiciones</a>
      <a href="#faq" class="hover:text-white transition-colors">Preguntas Frecuentes</a>
      <a href="#contacto" class="hover:text-white transition-colors">Soporte Técnico</a>
    </div>
  </div>
</footer>
