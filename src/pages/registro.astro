---
import Layout from '../layouts/Layout.astro';
import { RegistrationForm } from '../features/registration/components/RegistrationForm';
import { Leaf, GraduationCap, ArrowLeft } from 'lucide-react';
---

<Layout title="Registro de Participantes - III Encuentro Científico">
  <!-- Dynamic Rainforest background wrapper -->
  <div class="min-h-screen flex flex-col justify-between amazon-gradient-bg relative overflow-hidden selection:bg-primary selection:text-white">
    <!-- Forest glow overlays -->
    <div class="absolute top-[-10%] right-[-10%] w-[500px] h-[500px] bg-primary/10 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-[-10%] left-[-10%] w-[500px] h-[500px] bg-secondary/5 rounded-full blur-[120px] pointer-events-none"></div>

    <!-- Header / Branding Bar (No full navbar, just clean back navigation) -->
    <header class="w-full py-6 px-6 md:px-12 relative z-10 border-b border-white/[0.05] bg-dark/20 backdrop-blur-sm">
      <div class="container mx-auto flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group focus-visible:outline-2 focus-visible:outline-accent rounded-lg" aria-label="Volver a la página principal">
          <div class="relative w-9 h-9 bg-primary/20 rounded-xl flex items-center justify-center border border-primary/30 group-hover:border-primary/50 transition-all duration-300">
            <Leaf class="w-4 h-4 text-secondary absolute top-1.5 right-1.5" />
            <GraduationCap class="w-5.5 h-5.5 text-accent absolute bottom-1 left-1" />
          </div>
          <div class="flex flex-col">
            <span class="font-display font-black text-sm tracking-wide text-white leading-none uppercase">Escuela de Postgrado</span>
            <span class="text-[9px] text-accent font-bold uppercase tracking-widest leading-none mt-1">UNAP</span>
          </div>
        </a>

        <!-- Back Button -->
        <a 
          href="/" 
          class="inline-flex items-center gap-2 text-xs font-bold text-white/70 hover:text-white transition-colors py-2 px-4 rounded-full border border-white/10 hover:border-white/20 bg-white/5 backdrop-blur-sm cursor-pointer animate-fade-in"
        >
          <ArrowLeft class="w-3.5 h-3.5" />
          Volver al Inicio
        </a>
      </div>
    </header>

    <!-- Main Registration Section -->
    <main class="flex-grow flex items-center justify-center py-16 px-4 sm:px-6 relative z-10">
      <div class="w-full max-w-4xl">
        <div class="text-center mx-auto mb-10 max-w-2xl flex flex-col gap-3">
          <span class="text-xs font-bold text-secondary uppercase tracking-widest">
            Registro Oficial
          </span>
          <h1 class="font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-white">
            Ficha de Inscripción Digital
          </h1>
          <p class="text-xs sm:text-sm text-light/75 leading-relaxed">
            Completa tus datos personales y académicos para reservar tu certificación oficial emitida por la Escuela de Postgrado de la UNAP.
          </p>
        </div>

        <!-- Card Container -->
        <div class="bg-dark/45 backdrop-blur-md border border-accent/15 rounded-3xl p-6 sm:p-10 shadow-2xl relative overflow-hidden">
          {/* Subtle decoration inside the card */}
          <div class="absolute -top-20 -right-20 w-40 h-40 bg-secondary/10 rounded-full blur-2xl pointer-events-none"></div>
          
          <RegistrationForm client:load />
        </div>
      </div>
    </main>

    <!-- Minimalist Footer -->
    <footer class="w-full py-8 px-6 border-t border-accent/10 text-center relative z-10 bg-dark/35 backdrop-blur-sm">
      <div class="container mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-light/50">
        <p>© 2026 Universidad Nacional de la Amazonía Peruana. Escuela de Postgrado. Todos los derechos reservados.</p>
        <div class="flex gap-6">
          <a href="/#faq" class="hover:text-white transition-colors">Preguntas Frecuentes</a>
          <a href="/#contacto" class="hover:text-white transition-colors">Contacto & Soporte</a>
        </div>
      </div>
    </footer>
  </div>
</Layout>
