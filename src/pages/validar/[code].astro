---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import { verifyCertificateByCode } from '../../lib/supabase';

const { code } = Astro.params;
let verification = null;
let errorMsg = null;

if (code) {
  try {
    verification = await verifyCertificateByCode(code);
    if (!verification) {
      errorMsg = 'Código de verificación no válido o certificado no encontrado.';
    }
  } catch (e) {
    console.error('Error in verification route:', e);
    errorMsg = 'Ocurrió un error al procesar la verificación del certificado.';
  }
} else {
  errorMsg = 'Código de validación no suministrado.';
}

const eventName = verification?.event?.name || 'III Encuentro Científico';
const isRevoked = verification?.certificate?.is_revoked;
---

<Layout title={`Verificación de Certificado - ${eventName}`}>
  <Navbar />

  <main
    class="flex-grow pt-32 pb-24 amazon-gradient-bg relative overflow-hidden flex flex-col justify-center min-h-[75vh]"
  >
    {/* Decorative background glow */}
    <div
      class={`absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full blur-[120px] opacity-15 pointer-events-none ${
        errorMsg || isRevoked ? 'bg-red-500' : 'bg-emerald-500'
      }`}
    >
    </div>

    <div class="container mx-auto px-6 relative z-10 flex justify-center">
      <div
        class="w-full max-w-md bg-[#0a1510]/80 backdrop-blur-xl border border-white/10 rounded-3xl p-8 shadow-2xl relative overflow-hidden flex flex-col items-center"
      >
        {/* Glow decorative top */}
        <div
          class={`absolute -top-12 -right-12 w-24 h-24 rounded-full blur-2xl ${
            errorMsg || isRevoked ? 'bg-red-500/20' : 'bg-emerald-500/20'
          }`}
        >
        </div>

        {
          errorMsg ? (
            /* Error state */
            <div class="text-center space-y-6 w-full">
              <div class="size-16 bg-red-500/10 border border-red-500/20 text-red-400 rounded-2xl flex items-center justify-center mx-auto shadow-inner">
                <svg
                  class="size-8"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                  />
                </svg>
              </div>
              <div class="space-y-2">
                <h2 class="text-xl font-bold text-white">Verificación Fallida</h2>
                <p class="text-sm text-light/60 leading-relaxed px-4">{errorMsg}</p>
              </div>
              <div class="pt-6 border-t border-white/5 flex flex-col gap-3">
                <a
                  href="/certificados"
                  class="h-10 rounded-xl bg-white/5 hover:bg-white/10 text-light border border-white/10 flex items-center justify-center text-xs font-bold transition-colors"
                >
                  Ir a Consulta de Certificados
                </a>
                <p class="text-[9px] text-light/30 uppercase tracking-widest">
                  EPG UNAP Certificaciones
                </p>
              </div>
            </div>
          ) : isRevoked ? (
            /* Revoked State */
            <div class="text-center space-y-6 w-full">
              <div class="size-16 bg-red-500/10 border border-red-500/20 text-red-500 rounded-2xl flex items-center justify-center mx-auto shadow-inner">
                <svg
                  class="size-8"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                  />
                </svg>
              </div>
              <div class="space-y-2">
                <h2 class="text-xl font-bold text-red-400">Certificado Revocado</h2>
                <p class="text-xs text-light/60 leading-relaxed px-4">
                  Este certificado (Código:{' '}
                  <span class="font-mono font-bold text-white">{code}</span>) ha sido revocado y
                  marcado como **no válido** por la Escuela de Postgrado.
                </p>
              </div>

              <div class="bg-black/30 border border-white/5 rounded-2xl p-4 text-left space-y-3 w-full text-xs">
                <div>
                  <p class="text-[9px] uppercase text-light/40 font-bold tracking-wider">
                    Participante original
                  </p>
                  <p>{verification.participantName}</p>
                </div>
                <div class="border-t border-white/5 pt-2.5">
                  <p class="text-[9px] uppercase text-light/40 font-bold tracking-wider">Diploma</p>
                  <p>{verification.template?.name || 'Diploma de participación'}</p>
                </div>
              </div>

              <div class="pt-6 border-t border-white/5">
                <p class="text-[9px] text-light/30 uppercase tracking-widest">
                  EPG UNAP Certificaciones
                </p>
              </div>
            </div>
          ) : (
            /* Valid State */
            <div class="text-center space-y-6 w-full">
              <div class="size-16 bg-emerald-500/10 border border-emerald-500/20 text-emerald-450 rounded-2xl flex items-center justify-center mx-auto shadow-inner shadow-emerald-500/5">
                <svg
                  class="size-8 text-secondary animate-pulse"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
              </div>
              <div class="space-y-1">
                <h2 class="text-xl font-black text-secondary">Certificado Válido</h2>
                <p class="text-xs text-light/60 font-medium">
                  Documento de autenticidad verificado correctamente
                </p>
              </div>

              <div class="bg-black/30 border border-white/5 rounded-2xl p-4 text-left space-y-3 w-full text-xs">
                <div class="flex items-start gap-2.5 text-light/70">
                  <svg
                    class="size-4 shrink-0 text-secondary mt-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                    />
                  </svg>
                  <div>
                    <p class="text-[9px] uppercase text-light/40 font-bold tracking-wide">
                      Participante
                    </p>
                    <p class="font-bold text-white text-sm mt-0.5">
                      {verification.participantName}
                    </p>
                  </div>
                </div>

                <div class="flex items-start gap-2.5 text-light/70 border-t border-white/5 pt-2.5">
                  <svg
                    class="size-4 shrink-0 text-secondary mt-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"
                    />
                  </svg>
                  <div>
                    <p class="text-[9px] uppercase text-light/40 font-bold tracking-wide">
                      Certificación
                    </p>
                    <p class="font-semibold text-white mt-0.5">
                      {verification.template?.name || 'Diploma de participación'}
                    </p>
                  </div>
                </div>

                <div class="flex items-start gap-2.5 text-light/70 border-t border-white/5 pt-2.5">
                  <svg
                    class="size-4 shrink-0 text-secondary mt-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                    />
                  </svg>
                  <div>
                    <p class="text-[9px] uppercase text-light/40 font-bold tracking-wide">
                      Evento / Edición
                    </p>
                    <p class="font-semibold text-white mt-0.5">
                      {verification.event?.name
                        ? `${verification.event.name} - ${verification.edition?.name?.es || verification.edition?.name || ''}`
                        : 'III Encuentro Científico'}
                    </p>
                  </div>
                </div>

                <div class="flex items-start gap-2.5 text-light/70 border-t border-white/5 pt-2.5">
                  <svg
                    class="size-4 shrink-0 text-secondary mt-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    />
                  </svg>
                  <div>
                    <p class="text-[9px] uppercase text-light/40 font-bold tracking-wide">
                      Código de Validación
                    </p>
                    <p class="font-mono text-white font-bold mt-0.5">{code}</p>
                  </div>
                </div>
              </div>

              <div class="flex items-center justify-between text-[9px] text-light/40 uppercase px-1">
                <span>
                  Emisión:{' '}
                  {verification.certificate?.issued_at
                    ? new Date(verification.certificate.issued_at).toLocaleDateString('es-ES')
                    : ''}
                </span>
                <span>Validaciones: {verification.certificate?.validations_count || 0}</span>
              </div>

              <div class="pt-6 border-t border-white/5 flex flex-col gap-3">
                <a
                  href="/certificados"
                  class="h-10 rounded-xl bg-primary hover:bg-secondary text-white flex items-center justify-center text-xs font-bold transition-colors cursor-pointer shadow-md shadow-primary/10"
                >
                  Volver a Consulta de Certificados
                </a>
                <p class="text-[9px] text-light/30 uppercase tracking-widest">
                  EPG UNAP Certificaciones
                </p>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </main>

  <Footer />
</Layout>
