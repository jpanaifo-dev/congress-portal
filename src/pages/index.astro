---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Schedule from '../components/sections/Schedule.astro';
import Speakers from '../components/sections/Speakers.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/layout/Footer.astro';
import { StickyBottomBanner } from '../components/layout/StickyBottomBanner';
import { fetchConfig } from '../lib/supabase';

const config = await fetchConfig();
const startDateStr = config.edition?.start_date
  ? `${config.edition.start_date}T08:00:00-05:00`
  : '2026-07-02T08:00:00-05:00';
const eventName = config.event?.name || 'III Encuentro Científico';
const editionName = config.edition?.name?.es || '';
---

<Layout>
  <!-- Main sticky header -->
  <Navbar />

  <!-- Page Sections Container with Rainforest ambient gradients -->
  <main class="flex-grow amazon-gradient-bg">
    <!-- Hero Section -->
    <Hero />

    <!-- About the Event Section -->
    <About />

    <!-- Timeline Program Schedule Section -->
    <Schedule />

    <!-- Speakers Profile Cards Section -->
    <Speakers />

    <!-- Contact & Direct Location Map Section -->
    <Contact />
  </main>

  <!-- University Branded Footer -->
  <Footer />

  <!-- Sticky Countdown and Registration Quick-Bar -->
  <StickyBottomBanner
    client:load
    targetDateStr={startDateStr}
    eventName={eventName}
    editionName={editionName}
  />
</Layout>
