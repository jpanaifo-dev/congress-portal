---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Schedule from '../components/sections/Schedule.astro';
import Speakers from '../components/sections/Speakers.astro';
import Fees from '../components/sections/Fees.astro';
import GallerySection from '../components/sections/GallerySection.astro';
import Faq from '../components/sections/Faq.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/layout/Footer.astro';
---

<Layout>
  <!-- Main sticky header -->
  <Navbar />

  <!-- Page Sections Container with Rainforest ambient gradients -->
  <main class="flex-grow amazon-gradient-bg">
    <!-- Hero Section -->
    <Hero />

    <!-- About the Event Section -->
    <About />

    <!-- Timeline Program Schedule Section -->
    <Schedule />

    <!-- Speakers Profile Cards Section -->
    <Speakers />



    <!-- Certification Pricing Fees Section -->
    <Fees />

    <!-- Community Masonry Photos Gallery Section -->
    <GallerySection />

    <!-- Frequently Asked Questions Section -->
    <Faq />

    <!-- Contact & Direct Location Map Section -->
    <Contact />
  </main>

  <!-- University Branded Footer -->
  <Footer />
</Layout>
