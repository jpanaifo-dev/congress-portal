---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import { CompleteProgram } from '../features/home/components/CompleteProgram';
import Footer from '../components/layout/Footer.astro';
import { Calendar, Award, BookOpen, Clock } from 'lucide-react';
import { fetchConfig } from '../lib/supabase';

const config = await fetchConfig();
const editionId = config.edition?.id || "";
const eventName = config.event?.name || "III Encuentro Científico";
---

<Layout title={`Programa Científico Completo - ${eventName}`}>
  <!-- Navigation Header -->
  <Navbar />

  <!-- Main Body Wrapper with Rainforest ambient gradients -->
  <main class="flex-grow pt-32 pb-24 amazon-gradient-bg relative overflow-hidden">
    <!-- Glow elements -->
    <div class="absolute top-1/4 left-[-10%] w-[500px] h-[500px] bg-primary/10 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-1/4 right-[-10%] w-[500px] h-[500px] bg-secondary/5 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="container mx-auto px-6 md:px-12 relative z-10">
      
      <!-- Page Header -->
      <div class="text-center mx-auto mb-16 max-w-3xl flex flex-col gap-4">
        <span class="text-xs font-bold text-secondary uppercase tracking-widest animate-pulse">
          Cronograma Oficial
        </span>
        <h1 class="font-display font-extrabold text-4xl sm:text-5xl text-light">
          Programa Científico Completo
        </h1>
        <p class="text-sm sm:text-base text-light/75 leading-relaxed">
          Explore el itinerario oficial detallado del III Encuentro Científico de la Escuela de Postgrado. 
          Aquí encontrará todas las conferencias magistrales, ponencias libres y mesas redondas distribuidas por día.
        </p>
      </div>

      <!-- Quick stats bar (Visual design candy) -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto mb-16 p-4 glass-card border-accent/10 rounded-2xl text-center">
        <div class="flex flex-col py-2">
          <span class="text-2xl font-display font-black text-secondary">02</span>
          <span class="text-[10px] uppercase font-semibold text-light/50 tracking-wider">Días Académicos</span>
        </div>
        <div class="flex flex-col py-2 border-l border-light/10">
          <span class="text-2xl font-display font-black text-secondary">10+</span>
          <span class="text-[10px] uppercase font-semibold text-light/50 tracking-wider">Conferencias</span>
        </div>
        <div class="flex flex-col py-2 border-l border-light/10">
          <span class="text-2xl font-display font-black text-secondary">04</span>
          <span class="text-[10px] uppercase font-semibold text-light/50 tracking-wider">Áreas Temáticas</span>
        </div>
        <div class="flex flex-col py-2 border-l border-light/10">
          <span class="text-2xl font-display font-black text-secondary">ISBN</span>
          <span class="text-[10px] uppercase font-semibold text-light/50 tracking-wider">Publicación Actas</span>
        </div>
      </div>

      <!-- Dynamic Complete Program Component -->
      <CompleteProgram client:load editionId={editionId} />

    </div>
  </main>

  <!-- Global Footer -->
  <Footer />
</Layout>
